{
  "name": "arquitetos-portfolio-api",
  "version": "1.0.0",
  "description": "Backend API para escritório de arquitetura",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "deploy:start": "node dist/scripts/deploy-start.js",
    "lint": "eslint src",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "argon2": "^0.44.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "file-type": "^16.5.4",
    "helmet": "^8.0.0",
    "jose": "^6.2.3",
    "multer": "^2.1.1",
    "pg": "^8.13.3",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "prisma": "^7.8.0",
    "sanitize-html": "^2.17.3",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.11",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.21.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.0"
  }
}
